# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string. A free instance works fine (e.g. Neon: https://neon.tech).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional direct/unpooled URL used only by production migrations. When
# omitted, migrations use DATABASE_URL.
MIGRATION_DATABASE_URL="postgresql://user:password@direct-host/dbname?sslmode=require"

# Shared secret required by GET /api/rss-fetch. Generate one with:
#   openssl rand -base64 32
# and set the same value as a Vercel/GitHub Actions secret named CRON_SECRET.
CRON_SECRET="change-me"

# Free-tier Gemini API key for article summaries (/api/summarize).
# Get one at https://aistudio.google.com/apikey — no billing required.
GEMINI_API_KEY="change-me"

# Public deployed origin used for canonical and social metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"

# Optional database-backed limits for uncached summary generation.
SUMMARY_GLOBAL_RATE_LIMIT_PER_MINUTE="10"
SUMMARY_CLIENT_RATE_LIMIT_PER_MINUTE="5"
